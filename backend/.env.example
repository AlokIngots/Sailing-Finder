# Sailing Finder — configuration template.
# Copy to backend/.env on the VPS and fill in real values:
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored and must NEVER be committed, pasted into chat, or
# printed to a log. Names only in this file — no values.

# --- runtime ---------------------------------------------------------------
APP_ENV=production
PORT=8000
APP_PORT=8000
TZ=Asia/Kolkata
PUBLIC_URL=https://sailing.alokindia.com

# --- database --------------------------------------------------------------
# Used by the postgres container:
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sailing_finder
# Used by the app (host is the compose service name):
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/sailing_finder

# --- sessions --------------------------------------------------------------
# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE=sf_session
SESSION_TTL_HOURS=12

# --- Google Sheet (schedule source, read-only) -----------------------------
# Absolute path ON THE VPS to the service-account JSON key. Mounted read-only
# into the container; the key file itself is never committed.
GOOGLE_KEY_HOST_PATH=/opt/sailing_finder/secrets/google-key.json
# Path inside the container (matches the mount in docker-compose.yml):
GOOGLE_KEY_PATH=/run/secrets/google-key.json
SHEET_ID=18qW38SIfCma1zRye0W-6mcuQRwl7-2iEa-78-xjaBoM
SHEET_TAB=all_schedule

# --- scheduled jobs (cron syntax, in TZ above) -----------------------------
# Sync runs late morning, after the scrapers have finished.
SYNC_CRON=0 11 * * *
CLEANUP_CRON=30 11 * * *

# --- email (SMTP) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=exports@alokindia.com
SMTP_PASS=
MAIL_FROM=exports@alokindia.com
MAIL_FROM_NAME=Alok Ingots (Mumbai) Pvt. Ltd.
BOOKING_REPLY_TO=exports@alokindia.com

# --- forwarders (an enquiry emails each one SEPARATELY) --------------------
FORWARDER_1_NAME=
FORWARDER_1_EMAIL=
FORWARDER_2_NAME=
FORWARDER_2_EMAIL=
FORWARDER_3_NAME=
FORWARDER_3_EMAIL=

# --- WhatsApp (Interakt) ---------------------------------------------------
INTERAKT_API_KEY=
INTERAKT_TEMPLATE_NAME=
INTERAKT_TEMPLATE_LANG=en
INTERAKT_COUNTRY_CODE=91

# --- uploads / frontend ----------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=15
FRONTEND_DIST=/app/frontend_dist
